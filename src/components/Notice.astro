---
// Full-page message for visitors: thanks, expired link, voting closed…
import Base from "../layouts/Base.astro";

interface Props {
  title: string;
  text: string;
  status?: "success" | "error" | "info";
}

const { title, text, status = "error" } = Astro.props;
const icon = { success: "✔", error: "!", info: "i" }[status];
---

<Base title={title}>
  <main>
    <section class:list={["notice", "card", status]} role={status === "error" ? "alert" : "status"}>
      <span class="icon" aria-hidden="true">{icon}</span>
      <h1>{title}</h1>
      <p>{text}</p>
    </section>
  </main>
</Base>

<style>
  .notice {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 24px;
    padding: 32px 24px;
    text-align: center;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border: 1px solid #000;
    border-radius: 50%;
    box-shadow: var(--shadow);
    font-family: var(--display);
    font-weight: 800;
    font-size: 36px;
  }
  .success .icon {
    background: var(--sage);
  }
  .error .icon {
    background: var(--orange);
    color: white;
  }
  .info .icon {
    background: var(--lavender);
  }
  h1 {
    margin: 24px 0 12px;
    font-size: 26px;
  }
  p {
    margin: 0;
    font-size: 18px;
    color: var(--muted);
  }
</style>
