---
import { gameImage, type Edition } from "../lib/edition";
import { t } from "../lib/i18n";
import type { RankedGame } from "../lib/results";

interface Props {
  edition: Edition;
  games: RankedGame[];
  /** Number of Votes, to show each Game's Picks as a share of voters. */
  voters: number;
}

const { edition, games, voters } = Astro.props;
const share = (picks: number) => (voters ? Math.round((picks / voters) * 100) : 0);
const m = t(Astro.locals.locale);
---

<table class="results card">
  <thead>
    <tr>
      <th scope="col" class="rank">#</th>
      <th scope="col">{m.game}</th>
      <th scope="col" class="num">{m.votes}</th>
    </tr>
  </thead>
  <tbody>
    {
      games.map((game) => (
        <tr class:list={{ winner: game.rank === 1 }}>
          <td class="rank">{game.rank}</td>
          <td>
            <div class="game">
              <img src={gameImage(edition, game)} alt="" width="56" height="56" loading="lazy" />
              <span>
                <strong>{game.title}</strong>
                <small>{game.studio}</small>
              </span>
            </div>
          </td>
          <td class="num">
            {game.votes}
            <small class="share">{share(game.votes)}%</small>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .results {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
  }
  th {
    padding: 12px;
    font-family: var(--display);
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    text-align: left;
    background: var(--lavender);
    border-bottom: 1px solid #000;
  }
  td {
    padding: 10px 12px;
    border-bottom: 1px solid rgb(0 0 0 / 0.12);
  }
  tr:last-child td {
    border-bottom: 0;
  }
  .num {
    text-align: right;
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
  }
  .share {
    display: block;
    font-family: var(--body);
    font-weight: 500;
    font-size: 13px;
    color: var(--muted);
  }
  th.num {
    width: 5.5em;
    font-size: 13px;
  }
  .rank {
    width: 4.5em;
    white-space: nowrap;
    font-family: var(--display);
    font-weight: 700;
  }
  .game {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .game img {
    flex: none;
    object-fit: cover;
    border: 1px solid #000;
    border-radius: 6px;
  }
  .game span {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .game strong {
    font-family: var(--display);
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .game small {
    color: var(--muted);
  }
  .winner td {
    background: var(--yellow);
  }
  .winner .game img {
    width: 80px;
    height: 80px;
  }
  .winner .game strong,
  .winner .num {
    font-size: 24px;
  }
  @media (max-width: 600px) {
    th,
    td {
      padding: 8px;
    }
    .rank {
      width: 3.5em;
    }
    th.num {
      width: 5.2em;
    }
    .game {
      gap: 8px;
    }
    .winner .game img {
      width: 56px;
      height: 56px;
    }
    .winner .game strong,
    .winner .num {
      font-size: 18px;
    }
  }
  .winner .rank::before {
    content: "🏆 ";
  }
</style>
