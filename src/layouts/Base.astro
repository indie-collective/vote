---
// Visual identity follows the festival's site (stunfest.com, 2026 edition):
// yellow/lavender palette, Unbounded + Space Grotesk, outlined titles, hard-shadow cards, checkered strips.
import "@fontsource-variable/unbounded";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/700.css";
import { t } from "../lib/i18n";

interface Props {
  title?: string;
  /** Hide the header band and FR/EN switch (e.g. on the Host Screen). */
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
const locale = Astro.locals.locale;
const m = t(locale);
const other = locale === "fr" ? "en" : "fr";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={m.siteDescription} />
    <meta name="theme-color" content="#ffd348" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title ? `${title} · ${m.siteTitle}` : m.siteTitle}</title>
  </head>
  <body>
    {
      !bare && (
        <header class="band">
          <a class="wordmark" href="/">
            <img class="brand" src="/stunfest-2026-logo.png" alt="Stunfest 2026" width="91" height="48" />
            <span class="tagline">Indie Awards</span>
          </a>
          <a class="locale-switch" href={`${Astro.url.pathname}?lang=${other}`} hreflang={other}>
            {other.toUpperCase()}
          </a>
        </header>
        <div class="checker" aria-hidden="true" />
      )
    }
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --yellow: #ffd348;
    --lavender: #cec5ff;
    --orange: #d8613c;
    --sage: #b1c5a4;
    --sky: #8ed1fc;
    --paper: #ececec;
    --card: #f9f9f9;
    --ink: #111111;
    --muted: #636363;
    --display: "Unbounded Variable", "Unbounded", system-ui, sans-serif;
    --body: "Space Grotesk", system-ui, sans-serif;
    --radius: 10px;
    --shadow: 4px 4px 0 #000;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    min-height: 100%;
    margin: 0;
  }

  body {
    font-family: var(--body);
    font-weight: 500;
    color: var(--ink);
    background: var(--paper);
    -webkit-font-smoothing: antialiased;
  }

  main {
    max-width: 60ch;
    margin: 0 auto;
    padding: 28px 16px 120px;
  }

  h1,
  h2 {
    font-family: var(--display);
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
  }

  /* Festival-style title: light fill, thick black outline, stacked hard shadow. */
  .outlined {
    color: var(--lavender);
    -webkit-text-stroke: 4px #000;
    paint-order: stroke fill;
    text-shadow:
      1px 1px 0 #000,
      2px 2px 0 #000,
      3px 3px 0 #000,
      4px 4px 0 #000,
      5px 5px 0 #000;
  }

  .outlined.white {
    color: white;
  }

  .card {
    background: var(--card);
    border: 1px solid #000;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  /* Racing-flag strip: two rows of checks. */
  .checker {
    height: 24px;
    background: repeating-conic-gradient(#000 0 25%, #fff 0 50%) 0 0 / 24px 24px;
    border-block: 1px solid #000;
  }

  .band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    background: var(--yellow);
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }

  .brand {
    display: block;
    height: 48px;
    width: auto;
  }

  .tagline {
    font-weight: 700;
    font-size: 14px;
    text-transform: uppercase;
  }

  button,
  .button {
    font: inherit;
    font-family: var(--display);
    font-weight: 600;
    color: #000;
    background: var(--card);
    border: 1px solid #000;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 12px 20px;
    cursor: pointer;
    text-decoration: none;
    transition:
      transform 80ms,
      box-shadow 80ms;
  }

  button:active:not(:disabled),
  .button:active {
    transform: translate(3px, 3px);
    box-shadow: 1px 1px 0 #000;
  }

  button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  button.primary {
    background: var(--yellow);
  }

  .locale-switch {
    padding: 6px 12px;
    font-family: var(--display);
    font-weight: 600;
    font-size: 14px;
    color: #000;
    background: var(--card);
    border: 1px solid #000;
    border-radius: 999px;
    box-shadow: 2px 2px 0 #000;
    text-decoration: none;
  }

  :focus-visible {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
  }
</style>
