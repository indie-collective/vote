---
// Public Results: a holding page until an Organiser performs the Reveal.
import Notice from "../components/Notice.astro";
import ResultsTable from "../components/ResultsTable.astro";
import Base from "../layouts/Base.astro";
import { app } from "../lib/app";
import { t } from "../lib/i18n";
import { rankGames } from "../lib/results";
import { getStatus, tally } from "../lib/store";

const { db, edition, competition } = app();
const m = t(Astro.locals.locale);
const { revealed } = await getStatus(db, edition.id);
const results = revealed ? await tally(db, edition.id, competition.id) : { voters: 0, picks: {} };
const games = rankGames(competition.games, results.picks);
---

{
  revealed ? (
    <Base title={m.resultsTitle}>
      <main class="results-page">
        <h1 class="outlined white">{m.resultsTitle}</h1>
        <p class="edition">
          {edition.name} · {results.voters} {m.voters.toLowerCase()}
        </p>
        <ResultsTable edition={edition} games={games} voters={results.voters} />
      </main>
    </Base>
  ) : (
    <Notice title={m.holdingTitle} text={m.holdingText} status="info" />
  )
}

<style>
  .results-page {
    max-width: 90ch;
  }
  h1 {
    margin: 8px 0 4px;
    font-size: clamp(36px, 10vw, 64px);
  }
  .edition {
    margin: 0 0 28px;
    text-align: center;
    font-family: var(--display);
    font-weight: 600;
  }
</style>
