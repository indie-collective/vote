---
// Voting step: a visitor holding a Ballot picks one Game of the Competition.
import Notice from "../../components/Notice.astro";
import Base from "../../layouts/Base.astro";
import { app, BALLOT_COOKIE, cookieOptions, votedCookie } from "../../lib/app";
import { gameImage, type Game } from "../../lib/edition";
import { t } from "../../lib/i18n";
import { castVote, getStatus } from "../../lib/store";
import { readBallot } from "../../lib/voting";

const VOTED_COOKIE_DAYS = 30;

const { db, key, edition, competition } = app();
const m = t(Astro.locals.locale);
const thanks = { title: m.thanksTitle, text: m.thanksText, status: "success" as const };
const closed = { title: m.closedTitle, text: m.closedText, status: "info" as const };
const noBallot = { title: m.noBallotTitle, text: m.noBallotText };

const markVoted = () => {
  Astro.cookies.set(
    votedCookie(edition.id),
    "1",
    cookieOptions(Astro.url, VOTED_COOKIE_DAYS * 24 * 60 * 60)
  );
  Astro.cookies.delete(BALLOT_COOKIE, { path: "/vote" });
};

const ballot = await readBallot(Astro.cookies.get(BALLOT_COOKIE)?.value, edition.id, key);
let notice: { title: string; text: string; status?: "success" | "error" | "info" } | undefined;

if (Astro.cookies.has(votedCookie(edition.id))) {
  notice = thanks;
} else if (Astro.request.method === "POST") {
  const gameId = (await Astro.request.formData()).get("game");
  const game = competition.games.find((candidate) => candidate.id === gameId);

  if (!ballot) {
    notice = (await getStatus(db, edition.id)).votingOpen ? noBallot : closed;
  } else if (!game) {
    notice = { title: m.unknownGameTitle, text: m.unknownGameText };
    Astro.response.status = 400;
  } else {
    const result = await castVote(db, {
      edition: edition.id,
      category: competition.id,
      gameId: game.id,
      ballotId: ballot.id,
    });
    if (result === "closed") {
      notice = closed;
    } else {
      // "ballot-used" means this Ballot already produced a Vote (e.g. a double submit).
      markVoted();
      notice = thanks;
    }
  }
} else if (!(await getStatus(db, edition.id)).votingOpen) {
  notice = closed;
} else if (!ballot) {
  notice = noBallot;
}

/** Random order on every load so no Game benefits from being listed first. */
function shuffle(games: Game[]): Game[] {
  const copy = [...games];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}
---

{
  notice ? (
    <Notice {...notice} />
  ) : (
    <Base title={m.votePrompt}>
      <main>
        <h1 class="outlined">{m.votePrompt}</h1>
        <form method="post" id="ballot">
          <fieldset>
            <legend class="visually-hidden">{m.votePrompt}</legend>
            {shuffle(competition.games).map((game) => (
              <label class="game card">
                <input type="radio" name="game" value={game.id} required />
                <img src={gameImage(edition, game)} alt="" width="72" height="72" />
                <span class="title">{game.title}</span>
                <span class="studio">{game.studio}</span>
              </label>
            ))}
          </fieldset>
          <div class="bar">
            <div
              class="countdown"
              data-expires={ballot!.expiresAt}
              data-total={ballot!.expiresAt - Date.now()}
              role="timer"
              aria-label={m.timeLeft}
            >
              <span />
            </div>
            <button type="submit" class="primary" disabled>
              {m.voteButton}
            </button>
          </div>
        </form>
      </main>
    </Base>
  )
}

<script>
  const form = document.querySelector<HTMLFormElement>("#ballot");
  const countdown = document.querySelector<HTMLElement>(".countdown");

  if (form && countdown) {
    const submit = form.querySelector("button")!;
    form.addEventListener("change", () => (submit.disabled = false));
    form.addEventListener("submit", () => (submit.disabled = true));

    // Count down against the server-side expiry, using elapsed time so a skewed phone clock doesn't matter.
    const total = Number(countdown.dataset.total);
    const start = performance.now();
    const label = countdown.querySelector("span")!;
    const tick = () => {
      const left = Math.max(0, Math.ceil((total - (performance.now() - start)) / 1000));
      label.textContent = left > 60 ? `${Math.ceil(left / 60)}m` : String(left);
      countdown.style.setProperty("--progress", String((left * 1000) / total));
      if (left === 0) location.reload();
    };
    tick();
    setInterval(tick, 500);
  }
</script>

<style>
  h1 {
    margin: 8px 0 28px;
    font-size: clamp(28px, 8vw, 40px);
  }
  fieldset {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border: 0;
    margin: 0;
    padding: 0;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .game {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 16px;
    padding: 12px;
    cursor: pointer;
    transition:
      transform 80ms,
      box-shadow 80ms,
      background 80ms;
  }
  .game:has(input:checked) {
    background: var(--yellow);
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 #000;
  }
  .game:has(input:checked)::after {
    content: "✔";
    position: absolute;
    top: -10px;
    right: -10px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid #000;
    border-radius: 50%;
    background: var(--sage);
    font-weight: 700;
  }
  .game:has(input:focus-visible) {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
  }
  .game input {
    position: absolute;
    opacity: 0;
  }
  .game img {
    grid-row: 1 / 3;
    object-fit: cover;
    border: 1px solid #000;
    border-radius: 6px;
  }
  .title {
    align-self: end;
    font-family: var(--display);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.15;
  }
  .studio {
    align-self: start;
    font-size: 14px;
    color: var(--muted);
  }
  .bar {
    position: fixed;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px calc(14px + env(safe-area-inset-bottom));
    background: var(--card);
    border-top: 1px solid #000;
  }
  .countdown {
    --progress: 1;
    flex: none;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid #000;
    border-radius: 50%;
    background: conic-gradient(var(--orange) calc(var(--progress) * 360deg), var(--paper) 0);
  }
  .countdown span {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid #000;
    border-radius: 50%;
    background: white;
    font-family: var(--display);
    font-weight: 700;
    font-size: 13px;
  }
  .bar button {
    flex: 1;
    font-size: 22px;
    text-transform: uppercase;
  }
</style>
