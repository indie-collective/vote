---
// Organiser page: Voting Status, Reveal, and live Results.
import ResultsTable from "../components/ResultsTable.astro";
import Base from "../layouts/Base.astro";
import { app } from "../lib/app";
import { t } from "../lib/i18n";
import { rankGames } from "../lib/results";
import { getStatus, setRevealed, setVotingOpen, tally } from "../lib/store";

const { db, edition, competition } = app();
const m = t(Astro.locals.locale);

if (Astro.request.method === "POST") {
  const action = (await Astro.request.formData()).get("action");
  let refused = false;
  if (action === "open") await setVotingOpen(db, edition.id, true);
  if (action === "close") await setVotingOpen(db, edition.id, false);
  if (action === "reveal") refused = !(await setRevealed(db, edition.id, true));
  if (action === "unreveal") await setRevealed(db, edition.id, false);
  return Astro.redirect(refused ? "/admin?refused=reveal" : "/admin", 303);
}

const status = await getStatus(db, edition.id);
const results = await tally(db, edition.id, competition.id);
const games = rankGames(competition.games, results.picks);
---

<Base title={m.adminTitle}>
  <main class="admin">
    <h1 class="outlined">{m.adminTitle}</h1>
    <p class="edition">{edition.name}</p>

    <nav>
      <a href="/host">{m.hostLink}</a>
      <a href="/">{m.publicLink}</a>
      <form method="post" action="/logout"><button class="link">{m.logout}</button></form>
    </nav>

    <section class="controls">
      <form method="post" class="card">
        <p class:list={["badge", status.votingOpen ? "on" : "off"]}>
          {status.votingOpen ? m.votingOpen : m.votingClosed}
        </p>
        <button name="action" value={status.votingOpen ? "close" : "open"} class:list={{ primary: !status.votingOpen }}>
          {status.votingOpen ? m.closeVoting : m.openVoting}
        </button>
      </form>
      <form method="post" class="card">
        <p class:list={["badge", status.revealed ? "on" : "off"]}>
          {status.revealed ? m.revealed : m.notRevealed}
        </p>
        <button
          name="action"
          value={status.revealed ? "unreveal" : "reveal"}
          disabled={status.votingOpen}
          title={status.votingOpen ? m.revealNeedsClosed : undefined}
        >
          {status.revealed ? m.unreveal : m.reveal}
        </button>
      </form>
    </section>
    {
      (status.votingOpen || Astro.url.searchParams.has("refused")) && (
        <p class="hint">{m.revealNeedsClosed}</p>
      )
    }

    <section id="live">
      <p class="total">{m.totalVoters} : {results.voters}</p>
      <ResultsTable edition={edition} games={games} voters={results.voters} />
      <p class="hint">{m.refreshing}</p>
    </section>
  </main>
</Base>

<script>
  // Swap in fresh Results without reloading the page (and without disturbing the buttons).
  setInterval(async () => {
    try {
      const response = await fetch("/admin", { cache: "no-store" });
      if (response.redirected) return location.reload();
      const page = new DOMParser().parseFromString(await response.text(), "text/html");
      const fresh = page.querySelector("#live");
      if (fresh) document.querySelector("#live")!.replaceWith(fresh);
    } catch {
      // Ignore network blips.
    }
  }, 5000);
</script>

<style>
  .admin {
    max-width: 90ch;
  }
  h1 {
    margin: 8px 0 4px;
    font-size: 40px;
  }
  .edition {
    margin: 0 0 20px;
    text-align: center;
    font-family: var(--display);
    font-weight: 600;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-bottom: 28px;
  }
  nav a,
  .link {
    padding: 0;
    color: var(--ink);
    background: none;
    border: 0;
    box-shadow: none;
    font-family: var(--body);
    font-weight: 700;
    text-decoration: underline;
  }
  .controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .controls form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px;
  }
  .badge {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: 18px;
    text-transform: uppercase;
  }
  .badge::before {
    content: "";
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-right: 8px;
    border: 1px solid #000;
    border-radius: 50%;
  }
  .on::before {
    background: var(--sage);
  }
  .off::before {
    background: var(--paper);
  }
  .hint {
    font-size: 14px;
    text-align: center;
    color: var(--muted);
  }
  .total {
    margin: 28px 0 12px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
  }
</style>
