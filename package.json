{
  "name": "stunfest-vote",
  "private": true,
  "type": "module",
  "description": "Audience vote for the Stunfest Indie Awards",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "wrangler types",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "astro check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "astro build && wrangler deploy",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "astro": "^7.3.8",
    "qrcode": "^1.5.4",
    "three": "^0.186.1",
    "wrangler": "^4.149.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
